# ==============================================================================
# Fuel Route Optimizer - Environment Configuration
# ==============================================================================

# OpenRouteService API Key (get a free key at https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=your-openrouteservice-key-here

# Django Security Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,0.0.0.0

# CORS Configuration (comma-separated origins or * for open development)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache TTL (in seconds, default 24 hours = 86400)
ROUTE_CACHE_TTL=86400

# ORS Request Timeout (in seconds)
ORS_TIMEOUT=20
