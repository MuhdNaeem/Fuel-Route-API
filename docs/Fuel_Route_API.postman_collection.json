{
  "info": {
    "name": "Fuel Route Optimizer API",
    "description": "Production-grade REST collection for the Fuel Route Optimizer API. Includes system health checks, happy path road trips, caching validations, input boundary defenses, interactive visualizers, and error scenarios. Import together with Fuel_Route_API.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "0. System Health & Documentation",
      "item": [
        {
          "name": "0.1 Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health/",
              "host": ["{{base_url}}"],
              "path": ["api", "health", ""]
            },
            "description": "Verifies that the API service is operational, SQLite database is connected with 6,620 indexed fuel stations, and the in-memory cache is functioning."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Service status is healthy', () => pm.expect(d.status).to.eql('healthy'));",
                  "pm.test('Database is connected', () => pm.expect(d.database).to.eql('connected'));",
                  "pm.test('Stations are indexed', () => pm.expect(d.stations_indexed).to.be.above(6000));",
                  "pm.test('Cache is operational', () => pm.expect(d.cache).to.eql('operational'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 OpenAPI 3.0 Schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/schema/",
              "host": ["{{base_url}}"],
              "path": ["api", "schema", ""]
            },
            "description": "Retrieves the machine-readable OpenAPI 3.0 YAML/JSON specification schema generated dynamically by drf-spectacular."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Has OpenAPI specification', () => pm.expect(pm.response.text()).to.include('openapi'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 Swagger UI Documentation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/docs/",
              "host": ["{{base_url}}"],
              "path": ["api", "docs", ""]
            },
            "description": "Interactive Swagger UI documentation page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Happy Path Scenarios",
      "item": [
        {
          "name": "1.1 Cross-Country Trip (Los Angeles, CA -> New York, NY)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Long-distance cross-country trip (~2,800 miles). On cold cache makes 2 geocodes + 1 directions call. Includes Postman Visualizer dashboard for demonstration.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Los Angeles, CA\",\n  \"finish\": \"New York, NY\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Route geometry is GeoJSON LineString', () => {",
                  "    pm.expect(d.route.geometry.type).to.eql('LineString');",
                  "    pm.expect(d.route.geometry.coordinates).to.be.an('array').with.length.above(10);",
                  "});",
                  "pm.test('Total gallons consumed equals distance / 10 MPG', () => {",
                  "    pm.expect(d.summary.total_gallons).to.be.closeTo(d.route.distance_miles / 10, 0.5);",
                  "});",
                  "pm.test('No leg between stops exceeds 500 miles', () => {",
                  "    let prevMarker = 0.0;",
                  "    d.fuel_stops.forEach(stop => {",
                  "        pm.expect(stop.mile_marker - prevMarker).to.be.at.most(500.0);",
                  "        prevMarker = stop.mile_marker;",
                  "    });",
                  "    pm.expect(d.route.distance_miles - prevMarker).to.be.at.most(500.0);",
                  "});",
                  "pm.test('External API calls <= 3 on cold run', () => {",
                  "    pm.expect(d.meta.external_api_calls).to.be.at.most(3);",
                  "});",
                  "pm.test('Starting tank is properly accounted', () => {",
                  "    pm.expect(d.starting_tank.gallons).to.be.at.most(50.0);",
                  "    pm.expect(d.starting_tank.cost).to.be.above(0);",
                  "});",
                  "",
                  "// Postman Visualizer Dashboard (Click 'Visualize' tab)",
                  "const visualizerTemplate = `",
                  "<div style='font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;padding:16px;color:#2d3748;'>",
                  "  <h2 style='margin:0 0 4px 0;color:#1a202c;'>Cross-Country Fuel Route Summary</h2>",
                  "  <p style='color:#718096;margin:0 0 16px 0;font-size:14px;'><b>Origin:</b> {{start.label}} &rarr; <b>Destination:</b> {{finish.label}}</p>",
                  "  <div style='display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;'>",
                  "    <div style='background:#ebf8ff;border:1px solid #bee3f8;border-radius:8px;padding:12px;'>",
                  "      <div style='font-size:11px;color:#2b6cb0;font-weight:700;text-transform:uppercase;'>Distance</div>",
                  "      <div style='font-size:20px;font-weight:700;color:#2c5282;'>{{route.distance_miles}} mi</div>",
                  "    </div>",
                  "    <div style='background:#f0fff4;border:1px solid #c6f6d5;border-radius:8px;padding:12px;'>",
                  "      <div style='font-size:11px;color:#276749;font-weight:700;text-transform:uppercase;'>Total Fuel Cost</div>",
                  "      <div style='font-size:20px;font-weight:700;color:#22543d;'>\${{summary.total_fuel_cost_usd}}</div>",
                  "    </div>",
                  "    <div style='background:#faf5ff;border:1px solid #e9d8fd;border-radius:8px;padding:12px;'>",
                  "      <div style='font-size:11px;color:#6b46c1;font-weight:700;text-transform:uppercase;'>Fuel Stops</div>",
                  "      <div style='font-size:20px;font-weight:700;color:#553c9a;'>{{summary.number_of_fuel_stops}}</div>",
                  "    </div>",
                  "    <div style='background:#fffaf0;border:1px solid #feebc8;border-radius:8px;padding:12px;'>",
                  "      <div style='font-size:11px;color:#c05621;font-weight:700;text-transform:uppercase;'>External Calls</div>",
                  "      <div style='font-size:20px;font-weight:700;color:#9c4221;'>{{meta.external_api_calls}}</div>",
                  "    </div>",
                  "  </div>",
                  "  <h3 style='margin:0 0 8px 0;color:#2d3748;'>Cost-Optimal Refueling Stops</h3>",
                  "  <table style='width:100%;border-collapse:collapse;font-size:13px;border:1px solid #e2e8f0;'>",
                  "    <thead><tr style='background:#edf2f7;text-align:left;'>",
                  "      <th style='padding:8px 10px;border-bottom:2px solid #cbd5e0;'>#</th>",
                  "      <th style='padding:8px 10px;border-bottom:2px solid #cbd5e0;'>Station</th>",
                  "      <th style='padding:8px 10px;border-bottom:2px solid #cbd5e0;'>Location</th>",
                  "      <th style='padding:8px 10px;border-bottom:2px solid #cbd5e0;'>Mile Marker</th>",
                  "      <th style='padding:8px 10px;border-bottom:2px solid #cbd5e0;'>Price/Gal</th>",
                  "      <th style='padding:8px 10px;border-bottom:2px solid #cbd5e0;'>Gallons</th>",
                  "      <th style='padding:8px 10px;border-bottom:2px solid #cbd5e0;'>Stop Cost</th>",
                  "    </tr></thead>",
                  "    <tbody>",
                  "      {{#each fuel_stops}}",
                  "      <tr style='border-bottom:1px solid #e2e8f0;'>",
                  "        <td style='padding:8px 10px;font-weight:600;'>{{order}}</td>",
                  "        <td style='padding:8px 10px;'>{{name}}</td>",
                  "        <td style='padding:8px 10px;'>{{city}}, {{state}}</td>",
                  "        <td style='padding:8px 10px;'>{{mile_marker}} mi</td>",
                  "        <td style='padding:8px 10px;color:#2b6cb0;font-weight:600;'>\${{price_per_gallon}}</td>",
                  "        <td style='padding:8px 10px;'>{{gallons_purchased}} gal</td>",
                  "        <td style='padding:8px 10px;font-weight:700;color:#22543d;'>\${{cost}}</td>",
                  "      </tr>",
                  "      {{/each}}",
                  "    </tbody>",
                  "  </table>",
                  "</div>`;",
                  "pm.visualizer.set(visualizerTemplate, d);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Cached Query Verification (Run immediately after 1.1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Submits the identical trip as 1.1. Verifies that the in-process cache returns in <150ms with exactly 0 external API calls.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Los Angeles, CA\",\n  \"finish\": \"New York, NY\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Warm cache uses 0 external API calls', () => {",
                  "    pm.expect(d.meta.external_api_calls).to.eql(0);",
                  "});",
                  "pm.test('Cache response is ultra fast (<200ms)', () => {",
                  "    pm.expect(d.meta.processing_ms).to.be.below(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Mid-Length Route (Chicago, IL -> Denver, CO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Mid-distance trip (~1,000 miles). Tests interstate highway corridor matching and fuel optimization through Nebraska.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Valid stops planned', () => pm.expect(d.fuel_stops.length).to.be.above(0));",
                  "pm.test('Gallons match 10 MPG requirement', () => {",
                  "    pm.expect(d.summary.total_gallons).to.be.closeTo(d.route.distance_miles / 10, 0.5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Coordinates Input (1 External Call)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Submits raw 'lat,lng' coordinates. Demonstrates that geocoding is bypassed and exactly 1 external directions call is made on cold cache.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"34.05,-118.24\",\n  \"finish\": \"40.71,-74.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Coordinates input makes at most 1 external call', () => {",
                  "    pm.expect(d.meta.external_api_calls).to.be.at.most(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Short Trip - Zero Fuel Stops Needed (Dallas, TX -> Houston, TX)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Trip under 500 miles (~240 miles). Demonstrates that zero fuel stops are required, and the departure tank is valued at the first candidate station price.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Houston, TX\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Zero fuel stops needed', () => pm.expect(d.fuel_stops.length).to.eql(0));",
                  "pm.test('Departure tank cost matches distance burned', () => {",
                  "    pm.expect(d.summary.total_fuel_cost_usd).to.eql(d.starting_tank.cost);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 GET Method with Query Parameters (Atlanta, GA -> Phoenix, AZ)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/route/?start=Atlanta%2C%20GA&finish=Phoenix%2C%20AZ",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""],
              "query": [
                {
                  "key": "start",
                  "value": "Atlanta%2C%20GA"
                },
                {
                  "key": "finish",
                  "value": "Phoenix%2C%20AZ"
                }
              ]
            },
            "description": "Demonstrates GET query parameter support on the same route planning endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Route calculated via GET', () => pm.expect(d.route.distance_miles).to.be.above(1500));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Validation & Edge Cases",
      "item": [
        {
          "name": "2.1 Non-US Location Rejected (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Submitting a location outside the contiguous United States returns 400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Toronto, Canada\",\n  \"finish\": \"Chicago, IL\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const d = pm.response.json();",
                  "pm.test('Error field exists with descriptive message', () => {",
                  "    pm.expect(d.error).to.be.a('string').and.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Missing Required Field (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Submitting payload missing 'finish' returns 400 Bad Request with standardized error details.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Chicago, IL\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const d = pm.response.json();",
                  "pm.test('Error message notes missing field', () => {",
                  "    pm.expect(d.error).to.include('finish');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Identical Start and Finish (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Submitting identical start and finish points returns 400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Chicago, IL\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const d = pm.response.json();",
                  "pm.test('Error indicates identical locations', () => {",
                  "    pm.expect(d.error).to.include('identical');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Empty String Location (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Submitting whitespace-only locations returns 400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"   \",\n  \"finish\": \"Denver, CO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Coordinates Outside Contiguous USA (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": ["{{base_url}}"],
              "path": ["api", "route", ""]
            },
            "description": "Submitting coordinates outside the lower 48 states (e.g. London UK: 51.5,-0.12) returns 400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"51.5,-0.12\",\n  \"finish\": \"41.88,-87.63\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const d = pm.response.json();",
                  "pm.test('Error explains location is outside USA', () => {",
                  "    pm.expect(d.error.toLowerCase()).to.include('outside the contiguous united states');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
